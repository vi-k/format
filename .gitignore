# Files and directories created by pub
.dart_tool/
.packages


# Conventional directory for build outputs
build/
# Where a C/C++ extension drops its objects when the sprintf fixture
# generator is built from the editor. The generator that counts is built by
# tool/verify_generated_artifacts.dart into a temporary directory instead.
/tool/build/

# Locks stay local. This is a library, not an application: the versions that
# matter are the ranges in `pubspec.yaml`, and a committed lock would mean CI
# resolves what was resolved once rather than what the ranges allow today —
# which is exactly what the CI comment and the Dependabot comment both assume
# it does not do. The root lock was tracked by accident, swept in with the
# initial import, and untracked on 2026-08-13.
/pubspec.lock
/benchmark/suite/pubspec.lock
# Directory created by dartdoc
doc/api/

# Coverage output: the raw hits from `dart test --coverage` and the LCOV
# report converted from them. Both are measurements of a checkout, not part
# of it, and CI keeps the report as a build artifact instead.
.coverage/
coverage/
