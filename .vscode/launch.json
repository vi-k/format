{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "format",
      "request": "launch",
      "type": "dart",
      "program": "example/format_example.dart",
      "args": []
    },
    {
      "name": "Benchmark: comparison matrix",
      "request": "launch",
      "type": "dart",
      "program": "bin/benchmark.dart",
      "cwd": "${workspaceFolder}/benchmark/suite",
      "args": []
    },
    {
      "name": "Benchmark: double modes",
      "request": "launch",
      "type": "dart",
      "program": "bin/double_modes_benchmark.dart",
      "cwd": "${workspaceFolder}/benchmark/suite",
      "args": []
    },
    {
      "name": "Benchmark: list snapshot strategies",
      "request": "launch",
      "type": "dart",
      "program": "bin/list_snapshot_benchmark.dart",
      "cwd": "${workspaceFolder}/benchmark/suite",
      "args": []
    },
    {
      "name": "Benchmark: template IR vs legacy",
      "request": "launch",
      "type": "dart",
      "program": "bin/template_ir_benchmark.dart",
      "cwd": "${workspaceFolder}/benchmark/suite",
      "args": []
    },
    {
      "name": "Benchmark: release harness smoke",
      "request": "launch",
      "type": "dart",
      "program": "benchmark/runner.dart",
      "cwd": "${workspaceFolder}",
      "args": [
        "--runtime=jit",
        "--run=1",
        "--samples=1",
        "--smoke",
        "--output=/private/tmp/format3-vscode-smoke.json"
      ]
    },
    {
      "name": "Benchmark: parser strategy JIT",
      "request": "launch",
      "type": "dart",
      "program": "benchmark/parser_strategy.dart",
      "cwd": "${workspaceFolder}",
      "args": [
        "--runtime=jit",
        "--output=/private/tmp/parser-strategy-vscode-jit.json"
      ]
    },
    {
      "name": "test",
      "request": "launch",
      "type": "dart",
      "program": "test/format_test.dart",
      "args": []
    }
  ]
}